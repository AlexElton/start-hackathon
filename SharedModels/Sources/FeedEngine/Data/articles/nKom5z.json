   "paragraphs": [
    {
     "text": {
      "value": "Forsvaret skal få flere hundre milliarder de neste årene. Mye av det skal brukes i nord."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Men det må ikke bare bli utstyr. Det må bli arbeidsplasser, boliger og folk som blir boende."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Nord-Norge har fått mange løfter. Nå er det tid for å se resultater."
     }
    }
   ]
  }
 ]
