 "components": [
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Flere hundre naboer møtte opp da Ilaparken offisielt åpnet lørdag."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Parken har ny lekeplass, ballbinge, grillplass og en sti ned mot sjøen."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "– Vi har bedt om dette i over ti år. Endelig har barna et sted å være, sier Lise Rønning i Ila velforening."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Kommunen har brukt 28 millioner kroner på parken."
     }
    }
   ]
  }
 ]
