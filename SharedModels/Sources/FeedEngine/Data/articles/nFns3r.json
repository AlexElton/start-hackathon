   "paragraphs": [
    {
     "text": {
      "value": "Fra mandag stenges Gisundbrua mellom Finnsnes og Senja fra klokka 23 til 05 i tre uker."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Statens vegvesen skal skifte lagre og fuger på brua."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Utrykningskjøretøy slipper alltid gjennom, og det settes inn en ekstra ferge for nattskiftet på sykehuset."
     }
    }
   ]
  }
 ]
