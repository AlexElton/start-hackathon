 "components": [
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Kaldere vær og lite vind gjør at strømprisen i Midt-Norge ventes å stige neste uke."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "– Det viktigste er å flytte forbruket bort fra morgen og ettermiddag, sier forbrukerøkonom Lene Tangen."
     }
    }
   ]
  },
  {
   "type": "subheading",
   "text": {
    "value": "Fem raske grep"
   }
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Senk temperaturen med én grad. Det sparer rundt fem prosent av oppvarmingen."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Vask klær og ta oppvasken om kvelden eller natta, når strømmen er billigst."
     }
    }
   ]
  },
  {
   "type": "text",
   "paragraphs": [
    {
     "text": {
      "value": "Bor du i kollektiv, kan dere dele én strømavtale med lavt påslag."
     }
    }
   ]
  }
 ]
}